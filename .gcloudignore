# This file specifies files that are *not* uploaded to Google Cloud
# using gcloud. It follows the same syntax as .gitignore

# Node.js dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Python virtual environment
venv/
*.pyc
__pycache__/

# Development files
.env.local
.env.development
.env.test
tests/
*.test.ts
*.test.tsx
*.spec.ts
*.spec.tsx

# Build artifacts (will be built on GCP)
build/
dist/

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# Git files
.git/
.gitignore

# Documentation and planning
*.md
!README.md
todo.txt

# macOS files
.DS_Store

# Other
.cache/
coverage/
