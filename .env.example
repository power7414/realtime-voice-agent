# Copy to .env and fill in. Leave everything empty to run the scripted offline demo.
# CRA embeds REACT_APP_* values into the front-end bundle at build time:
# never deploy a build that contains real keys to a public URL.

# Google Gemini Live (https://aistudio.google.com/)
REACT_APP_GEMINI_API_KEY=

# Azure OpenAI Realtime
REACT_APP_AZURE_OPENAI_REALTIME_ENDPOINT=
REACT_APP_AZURE_OPENAI_REALTIME_API_KEY=
REACT_APP_AZURE_OPENAI_REALTIME_DEPLOYMENT_NAME=
REACT_APP_AZURE_OPENAI_REALTIME_API_VERSION=2024-10-01-preview

# Azure OpenAI chat completion (used by the STT-TTS mode)
REACT_APP_AZURE_OPENAI_ENDPOINT=
REACT_APP_AZURE_OPENAI_API_KEY=
REACT_APP_AZURE_OPENAI_DEPLOYMENT_NAME=
REACT_APP_AZURE_OPENAI_API_VERSION=2025-01-01-preview

# Force the offline mock clients even when keys are set
REACT_APP_USE_MOCK=false
