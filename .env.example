# 多模態 AI 對話平台 - 環境變數範例
# 複製此檔案為 .env 並填入你的 API 金鑰

# ==============================================
# Google Gemini API 設定
# ==============================================
# 取得位置: https://ai.google.dev/gemini-api
# 用於: Live API、STT、TTS 服務
REACT_APP_GEMINI_API_KEY=your_gemini_api_key_here

# ==============================================
# Azure OpenAI 設定
# ==============================================
# 取得位置: Azure Portal > Cognitive Services > OpenAI
# 用於: Realtime API、Chat Completion
REACT_APP_AZURE_OPENAI_KEY=your_azure_openai_key_here
REACT_APP_AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/

# Azure OpenAI 部署名稱 (通常是 gpt-4o-realtime-preview)
REACT_APP_AZURE_OPENAI_DEPLOYMENT=gpt-4o-realtime-preview

# Azure OpenAI API 版本
REACT_APP_AZURE_OPENAI_API_VERSION=2024-10-01-preview

# ==============================================
# Azure Speech Services 設定
# ==============================================
# 取得位置: Azure Portal > Cognitive Services > Speech
# 用於: 語音轉文字 (STT) 備用服務
REACT_APP_AZURE_SPEECH_KEY=your_azure_speech_key_here
REACT_APP_AZURE_SPEECH_REGION=eastus

# ==============================================
# 應用程式設定
# ==============================================
# 開發模式設定 (開發時使用)
NODE_ENV=development

# 生產模式設定 (部署時使用)
# NODE_ENV=production

# HTTPS 設定 (開發時可選)
# HTTPS=true

# 自訂 Port (開發時可選)
# PORT=3000

# ==============================================
# Docker 環境專用設定
# ==============================================
# Docker 容器內部使用的端口
# NGINX_PORT=8080

# ==============================================
# GCP Cloud Run 環境變數 (部署時使用)
# ==============================================
# Cloud Run 會自動設定 PORT 環境變數
# 請在 Cloud Run 控制台設定以下變數:
# - REACT_APP_GEMINI_API_KEY
# - REACT_APP_AZURE_OPENAI_KEY
# - REACT_APP_AZURE_OPENAI_ENDPOINT
# - REACT_APP_AZURE_SPEECH_KEY
# - REACT_APP_AZURE_SPEECH_REGION

# ==============================================
# 注意事項
# ==============================================
# 1. 所有 React 環境變數必須以 REACT_APP_ 開頭
# 2. 絕不要將此檔案提交到 Git (已在 .gitignore 中排除)
# 3. 在生產環境中建議使用 Secret Manager
# 4. API 金鑰請妥善保管，避免洩露